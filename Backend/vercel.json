{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "training sklearn/model.pkl",
          "training sklearn/feature_names.json",
          "training sklearn/label_classes.json",
          "training sklearn/release_evidences.json"
        ],
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "functions": {
    "main.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
