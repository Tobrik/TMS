# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tms

# JWT secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Must be set: without it every process (every serverless instance) invents its own
# key and tokens issued by one are rejected by another.
JWT_SECRET_KEY=change-me-to-a-random-secret

# JWT token expiration in minutes
JWT_EXPIRE_MINUTES=120

# Field-level encryption for medical data (Fernet key; generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DB_ENCRYPTION_KEY=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Set to true only behind a proxy that overwrites X-Forwarded-For
BEHIND_PROXY=false

# Doctor seeds: name|specialty|password;name|specialty|password
# DOCTOR_SEEDS=Doctor Name|specialty|password1;Another Doctor|specialty|password2

# ─── LLM (Groq) ───
# Without a key, extraction falls back to regex + BM25 and explanations to a fixed text.
GROQ_API_KEY=
# Ordered fallback lists. Groq retired llama-3.3-70b-versatile (2026-08-16) and
# llama-4-scout (2026-07-17); qwen3.8-27b is Groq's only vision model and is in
# the Preview tier (may be retired at short notice).
LLM_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_VISION_MODELS=qwen/qwen3.8-27b
# Extraction calls voted on per complaint. Keep 1 on Groq's base tier: its 8K
# tokens/minute limit fits one ~4.7K-token extraction request plus the safety
# review, not three. 3 = majority voting (paid tiers).
LLM_EXTRACTION_SAMPLES=1
# On HTTP 429, wait up to this many seconds (Groq's retry-after) and retry once
LLM_MAX_RETRY_WAIT=5

# ─── Symptom extraction backend ───
# groq (default) | clef. With clef, a failed or over-quota Clef call falls back
# to Groq, then regex.
EXTRACTION_BACKEND=groq

# ─── Cloudflare Clef ───
# Account ID: the 32-character part of the dashboard URL (dash.cloudflare.com/<id>/home).
# Token: dash.cloudflare.com/profile/api-tokens → Create Token → "Workers AI" template.
# Free plan: 10,000 neurons/day (~2.9M clef-flash tokens ≈ 130 complaints at ~22K
# tokens each), hard cap, never billed — past it, extraction falls back to Groq.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLEF_MODEL=clef-flash
